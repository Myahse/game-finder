# Copy to .env for docker compose.

# Required: 32+ random characters. e.g. `openssl rand -base64 48`
JWT_SECRET=

# Mapbox public token (https://account.mapbox.com/access-tokens/) — maps on web + mobile
VITE_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Accounts registered with these emails become admins (comma-separated).
# Leave empty in production until you add YOUR verified email(s). No email verification yet.
ADMIN_EMAILS=

# Seed demo courts in Grand-Bassam / Abidjan on start.
SEED_DEMO=false

# Optional: client error reporting (Sentry, etc.) — hook in web/src/lib/monitoring.ts
# VITE_SENTRY_DSN=

# Photo URLs returned by the API (use your PC LAN IP when testing on a phone).
# Example: PUBLIC_BASE_URL=http://192.168.1.42:8080
PUBLIC_BASE_URL=

# Optional: Firebase Cloud Messaging (HTTP v1) for push notifications.
# Without these, notifications are in-app only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
