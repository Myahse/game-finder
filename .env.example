# Copy to .env for docker compose.

# Required: 32+ random characters. e.g. `openssl rand -base64 48`
JWT_SECRET=

# Accounts registered with these emails become admins (comma-separated).
ADMIN_EMAILS=you@example.com

# Seed demo courts in Grand-Bassam / Abidjan on start.
SEED_DEMO=true

# Optional: Firebase Cloud Messaging (HTTP v1) for push notifications.
# Without these, notifications are in-app only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
