# Copy to .env for docker compose and sync-env.ps1 (mobile).

# =============================================================================
# Required
# =============================================================================
# Neon Postgres (Dashboard → Connection string, use pooled + sslmode=require)
# DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 32+ random characters: openssl rand -base64 48
JWT_SECRET=

# =============================================================================
# API (local Docker / Render)
# =============================================================================
# API public URL (upload links, mobile). LAN: http://192.168.x.x:8080 | prod: https://game-finder-ddcm.onrender.com
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated browser origins (include every Vercel URL + custom domain)
CORS_ORIGINS=http://localhost:9099,http://localhost:5173,https://game-finder-swart.vercel.app
SEED_DEMO=false
ADMIN_EMAILS=
# Email + password sign-up (default on). Set false only if you want Google/Firebase sign-in only.
PASSWORD_REGISTRATION=true
# Optional: verify new email accounts before first use (requires Resend).
# RESEND_API_KEY=
# EMAIL_FROM=Find the Game <onboarding@yourdomain.com>
# WEB_APP_URL=https://game-finder-swart.vercel.app
# ALLOW_VERCEL_PREVIEWS=false

# =============================================================================
# Cloudflare R2 — court & avatar images (recommended for production)
# =============================================================================
# Required on Render free tier (ephemeral disk). Optional locally (uses UPLOAD_DIR).
# R2 dashboard → Manage R2 API tokens (Object Read & Write) + enable public access on bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=game-finder-media
# Public URL: R2.dev subdomain or custom domain (no trailing slash)
R2_PUBLIC_URL=

# =============================================================================
# Mapbox (web + mobile maps)
# =============================================================================
# Web (Vercel): public token only — pk.* (never sk.* secret tokens)
VITE_MAPBOX_ACCESS_TOKEN=
# Mobile sync-env.ps1 copies from MAPBOX_ACCESS_TOKEN or VITE_MAPBOX_ACCESS_TOKEN
MAPBOX_ACCESS_TOKEN=

# =============================================================================
# Web (Vercel build env — also set in Vercel dashboard)
# =============================================================================
# Web + mobile client API (no trailing slash). Same host as PUBLIC_BASE_URL in prod.
# VITE_API_URL=https://game-finder-ddcm.onrender.com
# API_URL=https://game-finder-ddcm.onrender.com
# Public image CDN — use bucket *.r2.dev or custom domain (not *.cloudflarestorage.com)
# VITE_MEDIA_PUBLIC_ORIGIN=https://pub-xxxx.r2.dev

# Optional: Sentry
# VITE_SENTRY_DSN=

# =============================================================================
# Firebase Auth — Google sign-in without manual GCP OAuth clients (recommended)
# See docs/DEPLOY.md "Firebase Google Sign-In"
# =============================================================================
# API: verifies Firebase ID tokens (same value as Firebase console project ID)
FIREBASE_PROJECT_ID=
# Web (Vercel) + mobile (sync-env.ps1) — Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to <projectId>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# Web push (Cloud Messaging → Web Push certificates → public key). Without it, web users get in-app alerts only.
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# Google Sign-In (optional, direct OAuth) — see docs/DEPLOY.md "Google Sign-In"
# =============================================================================
# API: every OAuth client ID whose ID tokens are accepted (web, iOS; comma-separated)
GOOGLE_CLIENT_IDS=
# Web (Vercel) + mobile: the *Web application* client ID
VITE_GOOGLE_CLIENT_ID=
# Mobile (iOS only): the iOS client ID
GOOGLE_IOS_CLIENT_ID=

# =============================================================================
# Push (optional)
# =============================================================================
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
