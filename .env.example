# Copy to .env for docker compose and sync-env.ps1 (mobile).

# =============================================================================
# Required
# =============================================================================
# Neon Postgres (Dashboard → Connection string, use pooled + sslmode=require)
# DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 32+ random characters: openssl rand -base64 48
JWT_SECRET=

# =============================================================================
# API (local Docker / Fly.io)
# =============================================================================
# LAN testing on phone: http://192.168.x.x:8080  |  production: https://your-api.fly.dev
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:9099,http://localhost:5173
SEED_DEMO=false
ADMIN_EMAILS=

# =============================================================================
# Cloudflare R2 — court & avatar images (recommended for production)
# =============================================================================
# Leave empty to store uploads on disk (UPLOAD_DIR / Fly volume).
# R2 dashboard → Manage R2 API tokens (Object Read & Write) + enable public access on bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=game-finder-media
# Public URL: R2.dev subdomain or custom domain (no trailing slash)
R2_PUBLIC_URL=

# =============================================================================
# Mapbox (web + mobile maps)
# =============================================================================
VITE_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# =============================================================================
# Web (Vercel build env — also set in Vercel dashboard)
# =============================================================================
# Production API URL (no trailing slash). Empty in Docker nginx same-origin build.
# VITE_API_URL=https://your-api.fly.dev
# Must match R2_PUBLIC_URL when using R2 (optional if URLs are *.r2.dev)
# VITE_MEDIA_PUBLIC_ORIGIN=

# Optional: Sentry
# VITE_SENTRY_DSN=

# =============================================================================
# Push (optional)
# =============================================================================
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
