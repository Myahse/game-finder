# Copy to .env for docker compose and sync-env.ps1 (mobile).

# =============================================================================
# Required
# =============================================================================
# Neon Postgres (Dashboard → Connection string, use pooled + sslmode=require)
# DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 32+ random characters: openssl rand -base64 48
JWT_SECRET=

# =============================================================================
# API (local Docker / Render)
# =============================================================================
# API public URL (upload links, mobile). LAN: http://192.168.x.x:8080 | prod: https://game-finder-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated browser origins (include every Vercel URL + custom domain)
CORS_ORIGINS=http://localhost:9099,http://localhost:5173,https://your-app.vercel.app
SEED_DEMO=false
ADMIN_EMAILS=

# =============================================================================
# Cloudflare R2 — court & avatar images (recommended for production)
# =============================================================================
# Required on Render free tier (ephemeral disk). Optional locally (uses UPLOAD_DIR).
# R2 dashboard → Manage R2 API tokens (Object Read & Write) + enable public access on bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=game-finder-media
# Public URL: R2.dev subdomain or custom domain (no trailing slash)
R2_PUBLIC_URL=

# =============================================================================
# Mapbox (web + mobile maps)
# =============================================================================
VITE_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# =============================================================================
# Web (Vercel build env — also set in Vercel dashboard)
# =============================================================================
# Web + mobile client API (no trailing slash). Same host as PUBLIC_BASE_URL in prod.
# VITE_API_URL=https://game-finder-api.onrender.com
# API_URL=https://game-finder-api.onrender.com
# Public image CDN — use bucket *.r2.dev or custom domain (not *.cloudflarestorage.com)
# VITE_MEDIA_PUBLIC_ORIGIN=https://pub-xxxx.r2.dev

# Optional: Sentry
# VITE_SENTRY_DSN=

# =============================================================================
# Push (optional)
# =============================================================================
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
